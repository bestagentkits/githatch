{
  "name": "githoot",
  "version": "1.0.0",
  "description": "Gamified Developer Identity & Viral Gacha Hatch on Cloudflare Edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --d1=githoot_db --kv=GITHOOT_CACHE --r2=githoot --port=8788",
    "build": "npm run build:client && npm run build:server",
    "build:client": "vite build",
    "build:server": "esbuild src/server/index.ts --bundle --format=esm --platform=neutral --outfile=dist/_worker.js --external:cloudflare:*",
    "typecheck": "tsc --noEmit",
    "test": "npx tsx scripts/run-autonomous-qa.ts",
    "deploy": "wrangler pages deploy dist --project-name=githoot",
    "d1:migrate:local": "wrangler d1 migrations apply githoot_db --local",
    "d1:migrate:prod": "wrangler d1 migrations apply githoot_db_prod --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "hono": "^4.7.2",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^3.0.7",
    "wrangler": "^4.49.1"
  }
}
