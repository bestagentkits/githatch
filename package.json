{
  "name": "githoot",
  "version": "1.0.0",
  "description": "Gamified Developer Identity & Viral Gacha Hatch on Cloudflare Edge",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "wrangler pages dev dist --d1=githoot_db --kv=GITHOOT_CACHE --r2=githoot --port=8788",
    "build": "node scripts/build.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run tests/unit && vitest run tests/integration/harness.smoke.test.ts --config vitest.workers.config.ts && node --test .agents/skills/githoot-hatch/scripts/tests/determinism.test.mjs",
    "landing:gen": "node scripts/gen-landing16.mjs neonbyte",
    "landing:build": "node scripts/build-hatch-mockup-html.js",
    "landing:verify": "node scripts/verify-landing16.mjs",
    "test:routes": "node scripts/verify-real-routes.mjs",
    "deploy": "wrangler pages deploy dist --project-name=githoot",
    "d1:migrate:local": "wrangler d1 migrations apply githoot_db --local",
    "d1:migrate:prod": "wrangler d1 migrations apply githoot_db_prod --remote"
  },
  "dependencies": {
    "@hono/zod-validator": "^0.4.3",
    "@jsquash/webp": "^1.5.0",
    "hono": "^4.7.2",
    "wasm-feature-detect": "^1.9.0",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "^1.1.2",
    "@types/node": "^22.13.9",
    "@types/react": "^19.0.10",
    "@types/react-dom": "^19.0.4",
    "@vitejs/plugin-react": "^4.3.4",
    "esbuild": "^0.25.0",
    "puppeteer": "^23.11.1",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "sharp": "^0.35.4",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2",
    "vite": "^6.2.0",
    "vitest": "^4.1.11",
    "wrangler": "^4.49.1"
  }
}
